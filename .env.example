# Copiar a `.env` antes de `docker compose up`. Docker Compose lee `.env` solo.
#
# La clave firma los tokens de sesion. La de abajo sirve para desarrollo local;
# en cualquier despliegue real hay que generar una propia y no versionarla:
#
#   openssl rand -base64 48
#
# Minimo 32 bytes: HS256 no admite menos.
JWT_SECRET=clave-de-desarrollo-local-cambiar-en-despliegue-000

# Origenes autorizados a consumir la API desde el navegador.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Credenciales de PostgreSQL (valores por defecto del compose).
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin_password
POSTGRES_DB=dentalcite_db
